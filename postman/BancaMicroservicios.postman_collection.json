    {
      "name": "4. Reportes (F4)",
      "item": [
        {
          "name": "Estado de cuenta - Marianela Montalvo (detallado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{cuentasUrl}}/reportes?fecha={{fechaDesde}},{{fechaHasta}}&cliente=mmontalvo",
              "host": [
                "{{cuentasUrl}}"
              ],
              "path": [
                "reportes"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "{{fechaDesde}},{{fechaHasta}}"
                },
                {
                  "key": "cliente",
                  "value": "mmontalvo"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hoy = new Date();",
                  "const fmt = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
                  "const desde = new Date(hoy); desde.setDate(hoy.getDate() - 30);",
                  "pm.collectionVariables.set('fechaDesde', fmt(desde));",
                  "pm.collectionVariables.set('fechaHasta', fmt(hoy));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Incluye sus 2 cuentas\", () => pm.expect(pm.response.json().cuentas.length).to.eql(2));"
                ]
              }
            }
          ]
        },
